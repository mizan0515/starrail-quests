---
import {href} from '../lib/data';
const {records}=Astro.props;
---
<div class="record-index rw-index" data-record-index>
 <label class="atlas-search"><span class="sr-only">기록의 제목과 인용 구절 찾기</span><input type="search" data-record-query placeholder="기록의 제목과 인용 구절 찾기"/></label>
 <p class="explorer-count" role="status" aria-live="polite" data-record-count/>
 <div class="rw-index-links">{records.map((r,i)=><a id={'related-entry-'+i} class="rw-index-entry" data-record data-search={[r.title,...r.matches.map(h=>h.quote)].join(' ')} href={href(r.url)+'#'+r.matches[0].anchor} data-reading-link><small>{r.category}</small><strong>{r.title}</strong><span>{r.matches[0].quote}</span><span class="rw-index-arrow" aria-hidden="true">↗</span></a>)}</div>
 <p data-record-empty hidden>이 제목이나 인용 구절이 포함된 기록이 없습니다.</p><button type="button" class="record-more" data-record-more>더 보기</button><button type="button" class="record-more" data-record-reset>초기화</button>
</div>
<script>
import {readDirectoryState,writeDirectoryState,normalizeDirectoryText} from '../lib/directory-state.mjs';
for(const root of document.querySelectorAll<HTMLElement>('[data-record-index]')){
 const records=[...root.querySelectorAll<HTMLElement>('[data-record]')],input=root.querySelector<HTMLInputElement>('[data-record-query]')!,more=root.querySelector<HTMLButtonElement>('[data-record-more]')!;
 const options={queryKey:'relatedQuery',limitKey:'relatedLimit',groupKey:'relatedGroup',defaultLimit:12};let state=readDirectoryState(location.search,options);
 const update=(save=true)=>{const tokens=normalizeDirectoryText(input.value).split(' ').filter(Boolean),matches=records.filter(r=>tokens.every(t=>normalizeDirectoryText(r.dataset.search||'').includes(t)));records.forEach(r=>r.hidden=true);matches.slice(0,state.limit).forEach(r=>r.hidden=false);root.querySelector('[data-record-count]')!.textContent=`${matches.length}개 기록 · ${Math.min(state.limit,matches.length)}개 표시`;(root.querySelector('[data-record-empty]') as HTMLElement).hidden=!!matches.length;more.hidden=matches.length<=state.limit;state.query=input.value.trim();if(save)history.replaceState(null,'',writeDirectoryState(new URL(location.href),state,options));};
 const restore=()=>{state=readDirectoryState(location.search,options);input.value=state.query;update(false);};
 input.addEventListener('input',()=>{state.limit=12;update();});more.addEventListener('click',()=>{state.limit+=12;update();});root.querySelector('[data-record-reset]')!.addEventListener('click',()=>{input.value='';state.limit=12;update();input.focus();});window.addEventListener('popstate',restore);window.addEventListener('pageshow',restore);restore();
}
</script>
