---
import GroupedDirectory from './GroupedDirectory.astro';
import {allDiscoveryGroups,discoveryAxes} from '../lib/discovery';
const axis=Astro.props.axis||'region';
---
<GroupedDirectory id="explore" title="내용별로 원문 찾아 읽기" lead="지역의 역사와 장소, 인물의 발언, 조직과 세계의 법칙을 원문에서 읽습니다. 관심 있는 대상과 주제를 골라 개별 본문으로 이동할 수 있습니다." groups={allDiscoveryGroups} axes={discoveryAxes} axis={axis} queryKey="find" groupKey="group" limitKey="entityLimit" placeholder="예: 엘리오, 페가나, 허수의 나무"/>
