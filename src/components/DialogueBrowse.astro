---
import {dialogueData,dialogueUrl} from '../lib/explorer';
import {versionLabel,href,catalog} from '../lib/data';
const v=Astro.props.version||'';const pages=dialogueData.pages.filter(p=>!v||p.version===v);const total=dialogueData.versions.filter(x=>!v||x.version===v).reduce((n,x)=>n+x.count,0);
const names=Object.fromEntries(catalog.filter(d=>d.category==='퀘스트').map(d=>[d.id,d.title]));
const speakers=[...new Set(pages.flatMap(p=>p.speakers))].sort((a,b)=>a.localeCompare(b,'ko'));
---
<section class="dialogue-browser" data-dialogue-browser>
 <p class="eyebrow">한국어 대사 {total.toLocaleString()}개</p><h2>{v?versionLabel(v)+' · 전체 대사 원문':'전체 대사 원문'}</h2>
 <p class="page-deck">임무 연결 여부와 함께 전체 대사를 수록했습니다. 아래 원문 페이지는 대사 표의 순서에 따라 나뉩니다.</p>
 <div class="explorer-controls"><label><span class="sr-only">대사 묶음의 화자·임무 찾기</span><input type="search" data-dialogue-query placeholder="화자나 연결된 임무 이름"/></label><label><span class="sr-only">대사 화자</span><select data-dialogue-speaker><option value="">모든 화자</option>{speakers.map(s=><option>{s}</option>)}</select></label><button type="button" data-dialogue-reset>초기화</button></div>
 <p class="explorer-count" role="status" aria-live="polite" aria-atomic="true"/>
 <div class="dialogue-page-grid">{pages.map((p,i)=><a id={'dialogue-page-'+p.id} class="dialogue-page-card" href={dialogueUrl(p.id)} data-reading-link data-dialogue-page data-search={[...p.speakers,...p.missions.map(id=>names[id]||'')].join(' ')} data-speakers={JSON.stringify(p.speakers)} hidden={i>=24}><span class="eyebrow">{versionLabel(p.version)}</span><div><h3>원문 {p.part} · {p.count}개 대사</h3><p>{p.speakers.slice(0,4).map(s=>s==='{NICKNAME}'?'개척자':s).join(' · ')}{p.speakers.length>4?' 외':''}</p><span class="archive-meta">임무에 연결된 대사 {p.linked}개</span></div><span class="entity-action" aria-hidden="true">→</span></a>)}</div>
 <p class="dialogue-empty" hidden>해당 화자·임무가 포함된 묶음이 없습니다.</p><button type="button" data-dialogue-more>더 보기</button>
 <details class="version-note"><summary>버전·순서·미연결 대사의 근거</summary><p>버전별 TalkSentenceConfig 표에서 대사 ID가 처음 등장한 스냅샷을 대조했습니다. 본문과 화자는 설치된 게임의 한국어 파일에서 직접 읽었습니다. 실제 공개 날짜와는 다를 수 있습니다. 2.6 및 이전은 세부 버전을 미확인으로 표시합니다. 대사 묶음은 표 행 순서이며, 장면 실행 순서나 한 회차의 줄거리를 확정하지 않습니다. 컷신·분기를 연결하지 못한 대사도 삭제하지 않고 여기에 보존합니다.</p><a href={href('대사근거.json')}>파일·버전 표 해시 근거</a></details>
</section>
<script>
 import {normalizeDirectoryText,readDirectoryState,writeDirectoryState} from '../lib/directory-state.mjs';
 for(const root of document.querySelectorAll<HTMLElement>('[data-dialogue-browser]')){
  const cards=[...root.querySelectorAll<HTMLAnchorElement>('[data-dialogue-page]')],q=root.querySelector<HTMLInputElement>('[data-dialogue-query]')!,speaker=root.querySelector<HTMLSelectElement>('[data-dialogue-speaker]')!,more=root.querySelector<HTMLButtonElement>('[data-dialogue-more]')!;
  const options={queryKey:'dialogueQuery',groupKey:'dialogueSpeaker',limitKey:'dialogueLimit',defaultLimit:24};
  const search=new Map(cards.map(card=>[card,normalizeDirectoryText(card.dataset.search||'')]));
  const speakerNames=new Set([...speaker.options].map(option=>option.value));
  const pageSpeakers=new Map(cards.map(card=>[card,JSON.parse(card.dataset.speakers!)]));
  let state=readDirectoryState(location.search,options);
  const render=()=>{
   const tokens=normalizeDirectoryText(state.query).split(' ').filter(Boolean),result=cards.filter(card=>tokens.every(token=>search.get(card)!.includes(token))&&(!state.group||pageSpeakers.get(card).includes(state.group)));
   state.limit=Math.min(Math.max(24,state.limit),Math.max(24,Math.ceil(cards.length/24)*24));
   cards.forEach(card=>card.hidden=true);
   result.slice(0,state.limit).forEach(card=>{card.hidden=false;const url=new URL(card.href);state.group?url.searchParams.set('speaker',state.group):url.searchParams.delete('speaker');card.href=url.href;});
   root.querySelector('[role=status]')!.textContent=`${result.length}개 대사 묶음 · ${Math.min(state.limit,result.length)}개 표시`;
   more.hidden=result.length<=state.limit;more.textContent=`더 보기 · ${Math.max(0,Math.min(24,result.length-state.limit))}개`;
   (root.querySelector('.dialogue-empty') as HTMLElement).hidden=!!result.length;
  };
  const remember=()=>history.replaceState(history.state,'',writeDirectoryState(new URL(location.href),state,options));
  const restore=()=>{state=readDirectoryState(location.search,options);if(!speakerNames.has(state.group))state.group='';q.value=state.query;speaker.value=state.group;render();};
  q.addEventListener('input',()=>{state.query=q.value.trim();state.limit=24;render();remember();});
  speaker.addEventListener('change',()=>{state.group=speaker.value;state.limit=24;render();remember();});
  more.addEventListener('click',()=>{state.limit+=24;render();remember();});
  root.querySelector('[data-dialogue-reset]')!.addEventListener('click',()=>{state={...state,query:'',group:'',limit:24};q.value='';speaker.value='';render();remember();q.focus();});
  window.addEventListener('popstate',restore);window.addEventListener('pageshow',restore);restore();
 }
</script>
