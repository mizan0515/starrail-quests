---
import {catalog,docUrl,href,kinds,versions,versionLabel,readingCatalogVersion} from '../lib/data';
const {mode='quests',kind='',version=''}=Astro.props;
const isQuest=mode==='quests';
const source=catalog.filter(d=>isQuest?d.category==='퀘스트':d.category==='서적·문서');
const order=(d:any)=>Math.min(...d.versions.map((v:string)=>versions.indexOf(v)));
const initial=source.filter(d=>(!kind||d.kind===kind)&&(!version||d.versions.includes(version))).sort((a,b)=>(isQuest?order(a)-order(b):0)||a.worldRank-b.worldRank||a.chapterRank-b.chapterRank||a.rank-b.rank).slice(0,60);
const total=source.filter(d=>(!kind||d.kind===kind)&&(!version||d.versions.includes(version))).length;
const worlds=[...new Set(catalog.filter(d=>isQuest?d.category==='퀘스트':d.category!=='퀘스트').map(d=>d.world))].filter(w=>w&&w!=='분류 미확인');
const categories=['서적·문서','캐릭터 이야기','에이언즈·운명의 길','세계관·용어','광추 이야기','유물 이야기','아이템 설정','시뮬레이션 우주 설정','메시지','기타 장면'];
---
<section class="browse" data-mode={mode} data-kind={kind} data-version={version} data-order={JSON.stringify(versions)} data-versions={href('versions-data.json')} data-catalog={href('reading-catalog.json')+'?v='+readingCatalogVersion} data-base={href('문서/')} data-pagefind-ignore>
 {isQuest&&kind&&<nav class="type-tabs" aria-label="임무 종류">{Object.entries(kinds).map(([key,name])=><a aria-current={kind===name?'page':undefined} href={href(`quests/${key}.html`)}>{name}</a>)}</nav>}
 <form class="browse-filters" role="search" aria-label={isQuest?'임무 목록 필터':'원문 자료 필터'}>
  <label class="query-label">{isQuest?'임무 제목 또는 ID':'원문 자료 찾기'}<input type="search" name="q" placeholder={isQuest?'다시 읽을 임무 제목, ID':'서적·인물·설정 제목, ID'} autocomplete="off"/></label>
  {isQuest&&<label>버전<select name="version"><option value="">모든 버전</option>{versions.map(v=><option value={v} selected={v===version}>{versionLabel(v)}</option>)}</select></label>}
  {isQuest&&!kind&&<label>임무 종류<select name="kind"><option value="">모든 임무</option>{Object.values(kinds).map(k=><option>{k}</option>)}</select></label>}
  <label>지역<select name="world"><option value="">모든 지역</option>{worlds.map(w=><option>{w}</option>)}<option value="분류 미확인">지역 미분류</option></select></label>
  {!isQuest&&<label>자료 종류<select name="category">{categories.map(c=><option>{c}</option>)}</select></label>}
 </form>
 {isQuest&&!kind&&<div class="catalog-kind-buttons" role="group" aria-label="임무 종류 바로 선택">{['',...Object.values(kinds)].map(k=><button type="button" data-kind-choice={k} aria-pressed={k===''?'true':'false'}>{k||'전체'}<span data-kind-count/></button>)}</div>}
 <div class="result-bar"><p class="result-count" role="status" aria-live="polite">{total.toLocaleString()}개 {isQuest?'임무':'자료'}</p><div class="catalog-results-actions"><span>{isQuest?'버전 · 지역 · 챕터별':'종류 · 지역별'}</span><button class="reset-button" type="button">초기화 <span aria-hidden="true">↺</span></button></div></div>
 <div class="catalog-results">{initial.map(d=><a class="catalog-row" href={docUrl(d.id)}><span class="row-type">{d.kind||d.category}</span><span class="row-content"><strong class="row-title">{d.title}</strong><span class="row-detail">{d.world} · {d.id.replace('quest-','')} · {isQuest?d.dialogueCount?`대사 ${d.dialogueCount.toLocaleString()}행 · 선택지 ${d.choiceCount.toLocaleString()}개`:d.choiceCount?`선택지 ${d.choiceCount.toLocaleString()}개 · 대사 연결 확인 중`:'임무 개요 · 대사 연결 확인 중':`${d.count.toLocaleString()}개 원문 항목`}</span></span><span class="row-arrow" aria-hidden="true">→</span></a>)}</div>
 <button class="load-more" type="button" hidden>더 보기</button>
 <noscript><p>위 목록에서 원문을 읽을 수 있습니다. 검색·필터와 추가 목록은 JavaScript로 표시합니다.</p></noscript>
</section>
<script>
 for(const root of document.querySelectorAll<HTMLElement>('.browse')){
  const form=root.querySelector<HTMLFormElement>('form')!,container=root.querySelector<HTMLElement>('.catalog-results')!,count=root.querySelector<HTMLElement>('.result-count')!,more=root.querySelector<HTMLButtonElement>('.load-more')!,reset=root.querySelector<HTMLButtonElement>('.reset-button')!;
  const quest=root.dataset.mode==='quests',versionOrder=JSON.parse(root.dataset.order!),params=new URLSearchParams(location.search);
  let data:any[]=[],limit=Math.min(1500,Math.max(60,Number(params.get('limit'))||60));
  const field=(name:string)=>form.elements.namedItem(name) as HTMLInputElement|HTMLSelectElement|null;
  for(const name of ['q','world','version','kind','category']){const input=field(name);if(input&&params.has(name)){input.value=params.get(name)!;if(input instanceof HTMLSelectElement&&input.selectedIndex<0)input.selectedIndex=0;}}
  const el=(tag:string,cls:string,text:string)=>{const n=document.createElement(tag);n.className=cls;n.textContent=text;return n;};
  const normalize=(s:string)=>s.normalize('NFKC').toLocaleLowerCase('ko').replace(/\s/g,'');
  const versionName=(v:string)=>v==='early'?'1.0~2.6':v==='unknown'?'버전 미확인':v;
  const state=()=>Object.fromEntries(new FormData(form));
  const save=()=>{const u=new URL(location.href);for(const name of ['q','world','version','kind','category']){const input=field(name);if(input){input.value?u.searchParams.set(name,input.value):u.searchParams.delete(name);}}limit>60?u.searchParams.set('limit',String(limit)):u.searchParams.delete('limit');history.replaceState(history.state,'',u);};
  const render=(persist=true)=>{
   if(persist)save();const f=state(),q=normalize(String(f.q||'')),selectedKind=root.dataset.kind||f.kind;
   const filtered=data.filter(d=>(quest?d.category==='퀘스트'&&(!f.version||d.versions.includes(f.version)):d.category===f.category)&&(!f.world||d.world===f.world)&&(!q||normalize(d.title+' '+d.id).includes(q)));
   for(const button of root.querySelectorAll<HTMLButtonElement>('[data-kind-choice]')){button.setAttribute('aria-pressed',String(button.dataset.kindChoice===String(selectedKind||'')));button.querySelector('[data-kind-count]')!.textContent=String(filtered.filter(d=>!button.dataset.kindChoice||d.kind===button.dataset.kindChoice).length);}
   const kindOrder=['개척 임무','개척 후문','동행 임무','모험 임무','일일 임무'];
   const primary=(d:any)=>f.version||versionOrder.find((v:string)=>d.versions.includes(v))||'unknown';
   const result=filtered.filter(d=>!quest||!selectedKind||d.kind===selectedKind).sort((a,b)=>quest?versionOrder.indexOf(primary(a))-versionOrder.indexOf(primary(b))||kindOrder.indexOf(a.kind)-kindOrder.indexOf(b.kind)||a.worldRank-b.worldRank||a.chapterRank-b.chapterRank||a.rank-b.rank||a.title.localeCompare(b.title,'ko'):a.title.localeCompare(b.title,'ko'));
   container.replaceChildren();count.textContent=`${result.length.toLocaleString()}개 ${quest?'임무':'자료'} · ${Math.min(limit,result.length)}개 표시`;
   reset.disabled=!f.q&&!f.world&&!f.kind&&String(f.version||'')===(root.dataset.version||'')&&(!f.category||f.category==='서적·문서');
   if(!result.length){const empty=el('div','empty-state','');empty.append(el('h2','','찾는 자료가 없습니다'),el('p','','검색어를 짧게 바꾸거나 검색 조건을 초기화해 보세요.'));const clear=el('button','reset-button','검색 조건 초기화');clear.addEventListener('click',restore);empty.append(clear);container.append(empty);}
   const groups=new Map<string,any[]>();for(const d of result.slice(0,limit)){const key=quest?primary(d):(f.category==='유물 이야기'?d.collection:d.world);if(!groups.has(key))groups.set(key,[]);groups.get(key)!.push(d);}
   for(const [title,rows] of groups){const section=el('section','catalog-group',''),heading=el('h2',quest&&root.dataset.version&&f.version?'sr-only':'group-heading',quest?versionName(title):title),list=el('ul','catalog-list','');heading.append(el('span','group-count',`${rows.length}개 ${quest?'임무':'자료'} 표시`));section.append(heading);
    let lastChapter='';for(const d of rows){const li=document.createElement('li');const chapter=quest?[d.world,d.chapter==='챕터 미지정'?'':d.chapter].filter(Boolean).join(' · '):'';if(chapter!==lastChapter&&chapter){li.append(el('p','catalog-chapter',chapter));lastChapter=chapter;}
     const a=document.createElement('a');a.className='catalog-row';const u=new URL(root.dataset.base+d.id+'.html',location.href);u.searchParams.set('from',location.pathname+location.search);a.href=u.href;
     const detail=quest?d.dialogueCount?`대사 ${d.dialogueCount.toLocaleString()}행 · 선택지 ${d.choiceCount.toLocaleString()}개`:d.choiceCount?`선택지 ${d.choiceCount.toLocaleString()}개 · 대사 연결 확인 중`:'임무 개요 · 대사 연결 확인 중':`${d.count.toLocaleString()}개 원문 항목`;
     const content=el('span','row-content','');content.append(el('strong','row-title',d.title),el('span','row-detail',[d.id.replace('quest-',''),detail].join(' · ')));
     const arrow=el('span','row-arrow','→');arrow.setAttribute('aria-hidden','true');a.append(el('span','row-type',quest?d.kind:d.category),content,arrow);li.append(a);list.append(li);
    }section.append(list);container.append(section);
   }more.hidden=result.length<=limit;more.textContent=`더 보기 · ${Math.min(60,result.length-limit)}개`;
  };
  function restore(){form.reset();limit=60;render();field('q')?.focus();}
  form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('input',()=>{limit=60;render();});reset.addEventListener('click',restore);more.addEventListener('click',()=>{limit+=60;render();});
  if(/\/versions\/[^/]+\.html$/.test(location.pathname))field('version')?.addEventListener('change',()=>{const u=new URL(location.href);u.pathname=u.pathname.replace(/\/versions\/[^/]+\.html$/,`/versions/${field('version')!.value||'index'}.html`);u.searchParams.delete('version');u.searchParams.delete('limit');location.assign(u);});
  for(const button of root.querySelectorAll<HTMLButtonElement>('[data-kind-choice]'))button.addEventListener('click',()=>{field('kind')!.value=button.dataset.kindChoice||'';limit=60;render();});
  Promise.all([fetch(root.dataset.catalog!).then(r=>{if(!r.ok)throw new Error();return r.json();}),quest?fetch(root.dataset.versions!).then(r=>{if(!r.ok)throw new Error();return r.json();}):Promise.resolve({})]).then(([x,v])=>{data=x.map((d:any)=>({...d,versions:v[d.id]||[]}));render(false);}).catch(()=>{count.textContent='목록을 불러오지 못했습니다. 위 원문 링크를 이용하거나 새로고침해 주세요.';});
 }
</script>
