---
import GroupedDirectory from './GroupedDirectory.astro';
import {itemGroups} from '../lib/item-discovery';
import {href} from '../lib/data';
---
<GroupedDirectory id="item-library" title="아이템·기물·유물의 원문" lead="물건의 설명에서 인물과 문명의 기록으로 이어 읽습니다. 자료 종류를 먼저 고르고, 이름이나 원문 구절로 찾을 수 있습니다." groups={itemGroups} queryKey="item" groupKey="collection" limitKey="itemLimit" placeholder="예: 그라모스, 루버트, 기억"/>
<a class="universe-entry" href={href('유물.html')} id="relic-sets-entry" data-reading-link><strong>유물 배경 이야기를 세트별로 읽기</strong><span>62세트 · 192개 배경 이야기 →</span></a>
