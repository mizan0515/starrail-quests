---
import {atlas} from '../lib/atlas';
import {readingGraph,readingKit,readingClaim} from '../lib/reading-data';
const node=atlas.nodes.find(n=>n.id===Astro.props.nodeId);
const comparison=node?.comparison||atlas.comparisons[Astro.props.topic];
const cluster=readingGraph.clusters.find(c=>node?c.id==='atlas/'+node.id:c.topic===Astro.props.topic);
---
{comparison?.panels.length>0&&<section class="perspective-section" id="perspectives">
  <p class="eyebrow">기록을 나란히 읽기</p><h2>{comparison.title}</h2>
  <p class="comparison-scope">{comparison.scope}</p>
  <Fragment set:html={readingKit.comparison(cluster!.comparisons.map(p=>({...p,...readingClaim(p.claimId)})))} />
  {comparison.same&&<dl class="comparison-conclusions"><div><dt>함께 말하는 것</dt><dd>{comparison.same}</dd></div><div><dt>갈라지는 초점</dt><dd>{comparison.different}</dd></div><div><dt>편집자의 읽기</dt><dd>{comparison.reading}</dd></div></dl>}
</section>}
