---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import {href} from '../lib/data';
const pathname=Astro.url.pathname;
const main=[['index.html','퀘스트 목록'],['설정집.html','설정집'],['관점/region.html','지역'],['관점/person.html','인물'],['관점/concept.html','세계관의 큰 설정'],['자료안내.html','자료 안내']];
---
<div class="archive-sidebar"><p class="sidebar-caption">이야기 자료집</p><nav class="site-global-nav" aria-label="주요 탐색">{main.map(([url,title])=><a class="archive-nav-link" href={href(url)} aria-current={decodeURI(pathname)===decodeURI(href(url))?'page':undefined}>{title}</a>)}</nav>
<div class="sidebar-section"><a class="archive-nav-link" href={href('versions/early.html')} aria-current={pathname.endsWith('/early.html')?'page':undefined}>2.6 및 이전의 임무</a></div><details class="sidebar-section" open={pathname.includes('/versions/')||pathname.includes('/quests/')}><summary class="sidebar-caption">버전으로 찾기</summary><a class="archive-nav-link" href={href('versions/index.html')}>모든 버전</a>{[4,3,2].map(era=><div class="version-era"><span class="era-label">{era}.x</span><div class="version-grid">{(era===4?['4.5','4.4','4.3','4.2','4.1','4.0']:era===3?['3.8','3.7','3.6','3.5','3.4','3.3','3.2','3.1','3.0']:['2.7']).map(v=><a href={href('versions/'+v+'.html')} aria-current={pathname.endsWith('/'+v+'.html')?'page':undefined}>{v}</a>)}</div></div>)}</details>
<details class="sidebar-section"><summary class="sidebar-caption">임무 종류</summary>{[['main','개척 임무'],['continuance','개척 후문'],['companion','동행 임무'],['adventure','모험 임무'],['daily','일일 임무']].map(([id,title])=><a class="archive-nav-link" href={href('quests/'+id+'.html')}>{title}</a>)}</details>
<div class="sidebar-section"><a class="archive-nav-link" href={href('관점/aeon.html')}>에이언즈 · 운명의 길</a><a class="archive-nav-link" href={href('versions/index.html#dialogues')}>대사 원문 찾아보기</a></div><div class="md:sl-hidden"><MobileMenuFooter /></div></div>
