---
import {annotate,atlasUrl} from '../lib/atlas';
import {paragraphRuns} from '../lib/reading-kit/render.mjs';
import {href} from '../lib/data';
const {section,quest=false}=Astro.props;
const s=section;
function paragraphs(text:string){const rows:any[][]=[[]];annotate(text).forEach((part,termIndex)=>paragraphRuns(part.text).forEach((run,i)=>{if(i)rows.push([]);rows[rows.length-1].push({...part,text:run.text+run.separator,termIndex});}));return rows;}
---
<section class="source-section" id={s.anchor}>
  <h3>{s.title}</h3>
  {s.editorialPlacement&&<p class="placement-note">목표와 대사 내용을 대조한 편집자 배치</p>}
  <div class:list={['original-text',quest&&'dialogue']}>
    {s.rows.map((r,index)=><div class:list={['original-row',r.label==='선택지'&&'choice']} data-speaker={r.speaker} id={s.directTalkAnchors?'talk-'+r.talk_id:undefined}>
      <span class="speaker">{r.label==='선택지'?'선택지':r.speaker&&r.speaker!=='화자 미지정'?r.speaker:r.label==='배경 이야기'?'이야기':r.label&&r.label!=='본문'?r.label:'원문'}</span>
      <p class="original-body" id={`${s.anchor}-row-${index+1}`} data-pagefind-weight="1">{paragraphs(r.text).map(parts=><span class="original-paragraph">{parts.map(part=>part.id?<a class="context-term" id={`${s.anchor}-row-${index+1}-term-${part.termIndex}`} href={atlasUrl(part.id)} data-context-key={part.id} data-context-excerpt={r.text.slice(0,220)} aria-label={`${part.text} · 배경과 연결 보기`}>{part.text}</a>:part.text)}</span>)}</p>
      {r.destinations&&Object.keys(r.destinations).length>0&&r.label==='선택지'&&<span class="branch-note">선택 이후의 분기 조건이 있는 항목</span>}
    </div>)}
  </div>
  <details class="source-details" data-pagefind-ignore><summary>원문 출처와 식별자</summary><dl><dt>{s.sourceUrl?'임무 구조':'자료'}</dt><dd>{s.sourceUrl?<a href={s.sourceUrl}>{s.source} ↗</a>:s.source}</dd>{s.sourceSha256&&<><dt>구조 파일 SHA-256</dt><dd>{s.sourceSha256}</dd></>}{s.sourceTitle&&<><dt>원본 장면명</dt><dd>{s.sourceTitle}</dd></>}<dt>연결 근거</dt><dd>{s.mapping==='LOCAL_TABLE'?'로컬 표의 한국어 문자열':s.mapping==='LOCAL_SCENE_ID_ORDER_MATCH'?'로컬 장면에 대사 ID의 상대순서 일치':s.mapping==='EXACT_PUBLIC_STRUCTURE_REFERENCE_TO_PRESERVED_LOCAL_TALK'?'고정 임무 구조의 대사 ID 참조 · 보존된 로컬 한국어 원문':'보조 구조의 참조 · 실행 순서 미확인'}</dd></dl><ul>{s.rows.map(r=><li>{r.talk_id&&<>대사 {r.talk_id} · </>}문자열 {r.hash}{r.url&&<> · <a href={href(r.url)}>대사표 원문 ↗</a></>}{r.references&&<ul>{r.references.map(ref=><li>{ref.kind==='TalkSentence event reference'?'이벤트 대사 식별자':'대사 식별자'} · {ref.pointer}</li>)}</ul>}{r.destinations&&Object.keys(r.destinations).length>0&&<pre>{JSON.stringify(r.destinations,null,2)}</pre>}</li>)}</ul></details>
</section>
