---
import {annotate,atlasUrl} from '../lib/atlas';
import {paragraphRuns} from '../lib/reading-kit/render.mjs';
import {readerAttributes,rowAttributes,disclosureAttributes,sourceLinkAttributes} from '../lib/reading-kit/reader.mjs';
import {href,missionStructureUrl,missionPassageKind as passage} from '../lib/data';
const {section,quest=false}=Astro.props;
const s=section;
const contentRecord=s.ownership?.some(edge=>edge.kind==='EXPLICIT_CONTENT_PATH');
const rowProps=(r:any)=>({...rowAttributes(passage(r)),class:['rw-source-row','original-row',passage(r)==='choice'&&'choice',passage(r)==='gap'&&'source-gap'].filter(Boolean).join(' ')});
const rowAnchor=(r:any,index:number)=>r.readerRowAnchor||`${s.anchor}-row-${index+1}`;
const choiceTargets=(r:any)=>(r.branchTargets||[]).map((target:any)=>{const index=s.rows.findIndex((row:any)=>String(row.talk_id)===String(target.talkId));return index>=0?{...target,anchor:rowAnchor(s.rows[index],index),text:s.rows[index].text}:null;}).filter(Boolean);
const targetChoices=(talkId:any)=>s.rows.filter((row:any)=>passage(row)==='choice'&&row.branchTargets?.some((target:any)=>String(target.talkId)===String(talkId))).length;
function paragraphs(text:string){const rows:any[][]=[[]];annotate(text).forEach((part,termIndex)=>paragraphRuns(part.text).forEach((run,i)=>{if(i)rows.push([]);rows[rows.length-1].push({...part,text:run.text+run.separator,termIndex});}));return rows;}
const ownershipLabel={EXPLICIT_CONTENT_PATH:'콘텐츠 기록의 명시 경로',EXPLICIT_MAIN_MISSION_ID:'임무 소속의 명시 참조',EXPLICIT_JSON_PATH:'JSON 파일의 명시 경로',EXPLICIT_PERFORMANCE_LOOKUP:'연출 식별자와 파일 경로',EXACT_UNIQUE_EVENT_CHANNEL:'동일 이벤트의 유일한 송신·수신',MISSION_DIRECTORY_CONVENTION:'임무 폴더 번호',EXPLICIT_SUBMISSION_PERFORMANCE_BRANCH:'진행 조건·완료 ID와 연출의 명시 연결',EXPLICIT_SUBMISSION_FINISH_SCOPE:'완료 ID가 기록된 대화 범위',EXPLICIT_MISSION_FINISH_PERFORMANCE:'임무의 첫 대화 연출 식별자와 명시 경로',EXPLICIT_STARTED_SUBMISSION_MENU:'진행 중인 하위 임무의 대화 메뉴와 명시 경로'};
---
<section {...readerAttributes({variant:'scene',className:'source-section',id:s.anchor})}>
  <h3>{s.title}</h3>
  {s.relatedDocument&&<p class="mission-message-source"><a href={href(s.originalDocumentUrl)} {...sourceLinkAttributes({reading:true,id:s.anchor+'-original-message'})}>메시지 원문 · {s.sourceTitle} ↗</a></p>}
  {s.relatedDocument&&<details {...disclosureAttributes({className:'source-details'})} data-pagefind-ignore><summary>임무와 메시지의 연결 근거</summary><dl><dt>메시지 식별자</dt><dd>MessageSectionID · {s.relatedDocument.messageSectionId}</dd><dt>임무 구조의 참조</dt><dd><a href={missionStructureUrl(s.relatedDocument.referenceSource)} {...sourceLinkAttributes({variant:'inline'})}>{s.relatedDocument.referenceSource} ↗</a> · {s.relatedDocument.pointer}</dd><dt>임무 구조 SHA-256</dt><dd>{s.relatedDocument.referenceSourceSha256}</dd><dt>보존된 메시지 자료 SHA-256</dt><dd>{s.relatedDocument.sha256}</dd></dl></details>}
  {s.editorialPlacement&&<p class="placement-note">목표와 대사 내용을 대조한 편집자 배치</p>}
  <div class:list={['original-text',quest&&'dialogue']}>
    {s.rows.map((r,index)=><div {...rowProps(r)} data-speaker={r.speaker||'화자 미지정'} data-passage={passage(r)} id={s.directTalkAnchors?'talk-'+r.talk_id:undefined}>
      <span class="speaker rw-source-speaker">{passage(r)==='gap'?'본문 연결 확인 중':passage(r)==='choice'?'선택지':r.speaker&&r.speaker!=='화자 미지정'?r.speaker:r.label==='배경 이야기'?'이야기':r.label&&r.label!=='본문'?r.label:'원문'}</span>
      <p class="original-body rw-source-body" id={rowAnchor(r,index)} data-pagefind-weight="1">{paragraphs(r.text).map(parts=><span class="original-paragraph">{parts.map(part=>part.id?<a class="context-term" id={`${rowAnchor(r,index)}-term-${part.termIndex}`} href={atlasUrl(part.id)} data-context-key={part.id} data-context-excerpt={r.text.slice(0,220)} aria-label={`${part.text} · 배경과 연결 보기`}>{part.text}</a>:part.text)}</span>)}</p>
      {passage(r)==='choice'&&choiceTargets(r).length>0&&<nav class="universe-choice-path" aria-label="이 선택지의 진행 경로">{choiceTargets(r).map(target=><a {...sourceLinkAttributes()} href={'#'+target.anchor} data-choice-target={target.talkId}><span>{targetChoices(target.talkId)>1?`${targetChoices(target.talkId)}개 선택지가 합류하는 원문`:'이 선택 후 이어지는 원문'} <span aria-hidden="true">↓</span></span><span class="universe-choice-excerpt">{target.text}</span></a>)}</nav>}
      {r.destinations&&Object.keys(r.destinations).length>0&&passage(r)==='choice'&&!choiceTargets(r).length&&<span class="branch-note">선택 이후의 분기 조건이 있는 항목</span>}
    </div>)}
  </div>
  <details {...disclosureAttributes({className:'source-details'})} data-pagefind-ignore><summary>원문 출처와 식별자</summary>{s.referenceOnly&&<p class="source-scope-note">{s.talkScope?"이 묶음은 아래에 표시한 임무 연결 범위 밖의 원문입니다.":"임무 자료에 함께 수록된 추가 원문입니다."}</p>}<dl><dt>{s.sourceUrl?(contentRecord?'콘텐츠 기록의 구조':'임무 구조'):'자료'}</dt><dd>{s.sourceUrl?<a href={s.sourceUrl} {...sourceLinkAttributes({variant:'inline'})}>{s.source} ↗</a>:s.source}</dd>{s.sourceSha256&&<><dt>구조 파일 SHA-256</dt><dd>{s.sourceSha256}</dd></>}{s.sourceTitle&&<><dt>원본 장면명</dt><dd>{s.sourceTitle}</dd></>}{s.talkScope&&<><dt>{s.referenceOnly?"이 파일에서 임무와 연결된 대사 범위":"임무와 연결된 대사 범위"}</dt><dd>{s.talkScope.pointers.map(pointer=><p>{pointer}</p>)}<p>대사 식별자 {s.talkScope.talkIds.join(' · ')}</p></dd></>}<dt>대사 본문의 대조</dt><dd>{s.mapping==='LOCAL_TABLE'?'로컬 표의 한국어 문자열':s.mapping==='LOCAL_SCENE_ID_ORDER_MATCH'||s.mapping==='LOCAL_ID_ORDER_MATCH'?'로컬 장면의 대사 ID 순서 대조':s.mapping==='EXACT_PUBLIC_STRUCTURE_REFERENCE_TO_PRESERVED_LOCAL_TALK'?(contentRecord?'고정 콘텐츠 구조의 대사 ID 참조 · 보존된 로컬 한국어 원문':'고정 임무 구조의 대사 ID 참조 · 보존된 로컬 한국어 원문'):'보조 구조의 대사 식별자 참조 · 장면 대조 미확인'}</dd></dl>{s.ownership?.length>0&&<><p>{contentRecord?"기록과 대사의 연결 근거":s.referenceOnly?"파일 연결 근거":"임무 귀속의 연결 근거"}</p><ol>{s.ownership.map(edge=><li>{ownershipLabel[edge.kind]||edge.kind} · <a href={missionStructureUrl(edge.source)} {...sourceLinkAttributes({variant:'inline'})}>{edge.source} ↗</a>{edge.pointer&&<> · {edge.pointer}</>}{edge.missionId&&<> · 임무 {edge.missionId}</>}{edge.event&&<> · {edge.event}</>}{edge.performanceId&&<> · 연출 {edge.performanceId}</>}</li>)}</ol></>}<ul>{s.rows.map(r=><li>{r.talk_id&&<>대사 {r.talk_id} · </>}문자열 {r.hash}{r.url&&<> · <a href={href(r.url)} {...sourceLinkAttributes({reading:true,variant:'inline'})}>대사표 원문 ↗</a></>}{r.references&&<ul>{r.references.map(ref=><li>{ref.kind==='TalkSentence event reference'?'이벤트 대사 식별자':'대사 식별자'} · {ref.pointer}</li>)}</ul>}{r.destinations&&Object.keys(r.destinations).length>0&&<pre>{JSON.stringify(r.destinations,null,2)}</pre>}</li>)}</ul></details>
</section>
