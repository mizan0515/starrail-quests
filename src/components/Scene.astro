---
import {readerAttributes,rowAttributes,disclosureAttributes,sourceLinkAttributes} from '../lib/reading-kit/reader.mjs';
import {href,missionStructureUrl,missionPassageKind as passage,missionSourceNotice as sourceNotice} from '../lib/data';
import MissionOwnershipProof from './MissionOwnershipProof.astro';
import SourceParagraphs from './SourceParagraphs.astro';
import OfficialTalkProof from './OfficialTalkProof.astro';
import OfficialCaptionProof from './OfficialCaptionProof.astro';
import NativeVideoCaptionProof from './NativeVideoCaptionProof.astro';
import TimelineDialogueProof from './TimelineDialogueProof.astro';
import timelineDialogue from '../../data/timeline-mission-dialogue.json';
const {section,quest=false}=Astro.props;
const s=section;
const caption=s.recordType==='CUTSCENE_CAPTION';
const timeline=s.recordType==='TIMELINE_DIALOGUE';
const contentRecord=Array.isArray(s.ownership)&&s.ownership.some(edge=>edge.kind==='EXPLICIT_CONTENT_PATH');
const rowProps=(r:any)=>({...rowAttributes(passage(r)==='caption'?'original':passage(r)),class:['rw-source-row','original-row',passage(r)==='choice'&&'choice',passage(r)==='gap'&&'source-gap',caption&&'video-caption-row'].filter(Boolean).join(' ')});
const timestamp=(seconds:number)=>{const milliseconds=Math.round(seconds*1000),minutes=Math.floor(milliseconds/60000),rest=milliseconds%60000;return `${String(minutes).padStart(2,'0')}:${String(Math.floor(rest/1000)).padStart(2,'0')}.${String(rest%1000).padStart(3,'0')}`;};
const rowAnchor=(r:any,index:number)=>r.readerRowAnchor||`${s.anchor}-row-${index+1}`;
const choiceTargets=(r:any)=>(r.branchTargets||[]).map((target:any)=>{const index=s.rows.findIndex((row:any)=>String(row.talk_id)===String(target.talkId));return index>=0?{...target,anchor:rowAnchor(s.rows[index],index),text:s.rows[index].text}:null;}).filter(Boolean);
const targetChoices=(talkId:any)=>s.rows.filter((row:any)=>passage(row)==='choice'&&row.branchTargets?.some((target:any)=>String(target.talkId)===String(talkId))).length;
---
<section {...readerAttributes({variant:'scene',className:'source-section',id:s.anchor})}>
  <h3>{s.title}</h3>
  {caption&&(s.nativePlaybackSource?<NativeVideoCaptionProof section={s}/>:<OfficialCaptionProof section={s}/>)}
  {timeline&&<TimelineDialogueProof section={s}/>}
  {s.relatedDocument&&<p class="mission-message-source"><a href={href(s.originalDocumentUrl)} {...sourceLinkAttributes({reading:true,id:s.anchor+'-original-message'})}>메시지 원문 · {s.sourceTitle} ↗</a></p>}
  {s.relatedDocument&&<details {...disclosureAttributes({className:'source-details'})} data-pagefind-ignore><summary>임무와 메시지의 연결 근거</summary><dl><dt>메시지 식별자</dt><dd>MessageSectionID · {s.relatedDocument.messageSectionId}</dd><dt>임무 구조의 참조</dt><dd><a href={missionStructureUrl(s.relatedDocument.referenceSource)} {...sourceLinkAttributes({variant:'inline'})}>{s.relatedDocument.referenceSource} ↗</a> · {s.relatedDocument.pointer}</dd><dt>임무 구조 SHA-256</dt><dd>{s.relatedDocument.referenceSourceSha256}</dd><dt>보존된 메시지 자료 SHA-256</dt><dd>{s.relatedDocument.sha256}</dd></dl></details>}
  {s.editorialPlacement&&<p class="placement-note">목표와 대사 내용을 대조한 편집자 배치</p>}
  <div class:list={['original-text',quest&&'dialogue']}>
    {s.rows.map((r,index)=><div {...rowProps(r)} data-speaker={r.speaker||'화자 미지정'} data-passage={passage(r)} id={s.directTalkAnchors?'talk-'+r.talk_id:undefined}>
      <span class="speaker rw-source-speaker">{sourceNotice(r)?'원문에 수록된 제작 안내':passage(r)==='gap'?'본문 연결 확인 중':passage(r)==='choice'?'선택지':r.speaker&&r.speaker!=='화자 미지정'?r.speaker:r.label==='배경 이야기'?'이야기':r.label&&r.label!=='본문'?r.label:'원문'}</span>
      {caption&&<span class="caption-time" data-caption-time={index} aria-label={`영상 안의 재생 시각 ${timestamp(r.startTime)}부터 ${timestamp(r.endTime)}까지`}>{timestamp(r.startTime)}<span aria-hidden="true">–</span>{timestamp(r.endTime)}</span>}
      {r.sourceConditions?.map(condition=><p class="source-condition-note" data-source-condition={condition.referencePointer}>파일의 분기 조건 · {condition.name} = {condition.value}</p>)}
      <SourceParagraphs text={r.text} anchor={rowAnchor(r,index)}/>
      {r.officialSource&&<OfficialTalkProof row={r} evidence={timeline?timelineDialogue.evidence.officialKorean:undefined}/>}
      {timeline&&r.url&&<a id={rowAnchor(r,index)+'-source'} href={href(r.url)} {...sourceLinkAttributes({reading:true,variant:'inline'})}>대사표 원문 ↗</a>}
      {passage(r)==='choice'&&choiceTargets(r).length>0&&<nav class="universe-choice-path" aria-label="이 선택지의 진행 경로">{choiceTargets(r).map(target=><a {...sourceLinkAttributes()} href={'#'+target.anchor} data-choice-target={target.talkId}><span>{targetChoices(target.talkId)>1?`${targetChoices(target.talkId)}개 선택지가 합류하는 원문`:'이 선택 후 이어지는 원문'} <span aria-hidden="true">↓</span></span><span class="universe-choice-excerpt">{target.text}</span></a>)}</nav>}
      {r.destinations&&Object.keys(r.destinations).length>0&&passage(r)==='choice'&&!choiceTargets(r).length&&<span class="branch-note">선택 이후의 분기 조건이 있는 항목</span>}
    </div>)}
  </div>
  {!caption&&<details {...disclosureAttributes({className:'source-details'})} data-pagefind-ignore><summary>원문 출처와 식별자</summary>{s.referenceOnly&&<p class="source-scope-note">{s.talkScope?"이 묶음은 아래에 표시한 임무 연결 범위 밖의 원문입니다.":"임무 자료에 함께 수록된 추가 원문입니다."}</p>}<dl><dt>{s.sourceUrl?(contentRecord?'콘텐츠 기록의 구조':'임무 구조'):'자료'}</dt><dd>{s.sourceUrl?<a href={s.sourceUrl} {...sourceLinkAttributes({variant:'inline'})}>{s.source} ↗</a>:s.source}</dd>{s.sourceSha256&&<><dt>구조 파일 SHA-256</dt><dd>{s.sourceSha256}</dd></>}{s.sourceTitle&&<><dt>원본 장면명</dt><dd>{s.sourceTitle}</dd></>}{s.talkScope&&<><dt>{s.referenceOnly?"이 파일에서 임무와 연결된 대사 범위":"임무와 연결된 대사 범위"}</dt><dd>{s.talkScope.pointers.map(pointer=><p>{pointer}</p>)}<p>대사 식별자 {s.talkScope.talkIds.join(' · ')}</p></dd></>}<dt>대사 본문의 대조</dt><dd>{timeline?'연출 장면의 대사 ID 참조 · 공식 4.6 한국어 원문과 보존 대사표 대조':s.mapping==='EXACT_PUBLIC_STRUCTURE_REFERENCE_TO_OFFICIAL_KOREAN_TALK'?'고정 임무 구조의 대사 ID 참조 · 별도 버전의 공식 한국어 원문':s.mapping==='EXACT_PUBLIC_STRUCTURE_REFERENCE_TO_MIXED_KOREAN_TALK'?'고정 임무 구조의 대사 ID 참조 · 행별로 구분한 한국어 원문':s.mapping==='LOCAL_TABLE'?'로컬 표의 한국어 문자열':s.mapping==='LOCAL_SCENE_ID_ORDER_MATCH'||s.mapping==='LOCAL_ID_ORDER_MATCH'?'로컬 장면의 대사 ID 순서 대조':s.mapping==='EXACT_PUBLIC_STRUCTURE_REFERENCE_TO_PRESERVED_LOCAL_TALK'?(contentRecord?'고정 콘텐츠 구조의 대사 ID 참조 · 보존된 로컬 한국어 원문':'고정 임무 구조의 대사 ID 참조 · 보존된 로컬 한국어 원문'):'보조 구조의 대사 식별자 참조 · 장면 대조 미확인'}</dd></dl>{s.ownership?.length>0&&<><p>{contentRecord?"기록과 대사의 연결 근거":s.referenceOnly?"파일 연결 근거":"임무 귀속의 연결 근거"}</p><ol>{s.ownership.map(edge=><MissionOwnershipProof edge={edge}/>)}</ol></>}<ul>{s.rows.map(r=><li>{r.talk_id&&<>대사 {r.talk_id} · </>}문자열 {r.hash}{!timeline&&r.url&&<> · <a href={href(r.url)} {...sourceLinkAttributes({reading:true,variant:'inline'})}>대사표 원문 ↗</a></>}{r.references&&<ul>{r.references.map(ref=><li>{ref.kind==='TalkSentence event reference'?'이벤트 대사 식별자':'대사 식별자'} · {ref.pointer}</li>)}</ul>}{r.destinations&&Object.keys(r.destinations).length>0&&<pre>{JSON.stringify(r.destinations,null,2)}</pre>}</li>)}</ul></details>}
</section>
<style>
  .source-condition-note{margin-block:.4rem .75rem;font-size:.82rem;line-height:1.6;color:var(--sl-color-gray-2);overflow-wrap:anywhere}
  .video-caption-row{position:relative;display:grid;grid-template-columns:10.5rem minmax(0,1fr);align-items:baseline;gap:0 1rem;padding:.65rem .75rem;margin-block:.25rem!important;border-inline-start:2px solid var(--sl-color-hairline)}
  .video-caption-row .speaker{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .video-caption-row :global(.original-body){min-width:0;margin:0!important}
  .caption-time{display:block;margin:0;font-variant-numeric:tabular-nums;font-size:.78rem;color:var(--sl-color-gray-2);white-space:nowrap}
  @media(max-width:600px){.video-caption-row{grid-template-columns:minmax(0,1fr);gap:.2rem;padding-inline:.6rem}}
</style>
