---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Browse from '../components/Browse.astro';
import AtlasHub from '../components/AtlasHub.astro';
import Explorer from '../components/Explorer.astro';
import {topics,topicUrl} from '../lib/data';
import guides from '../../editorial/reading-guides.json';
import {href} from '../lib/data';
import {discoveryAxes,allDiscoveryGroups} from '../lib/discovery';
const shelves=[
 {title:'신앙과 질서',deck:'에이언즈의 이념과 이를 계승하는 파벌의 기록.',ids:['paths-and-factions']},
 {title:'영생과 종족',deck:'장생이 남긴 사회의 변화와 부족별 생활·소속.',ids:['xianzhou-immortality','borisin-and-foxians']},
 {title:'도시와 기억',deck:'도시의 건설, 주민의 생활, 역사의 작성과 복원.',ids:['belobog-preservation','penacony-memory']},
 {title:'생명과 지식',deck:'달력과 학문의 규칙, 생명과 감정에 관한 연구.',ids:['amphoreus-myth-and-life','herta-life-and-knowledge']},
];
---
<StarlightPage frontmatter={{title:'설정집 · 연결해서 읽기',description:'붕괴: 스타레일의 지역·인물·세력·세계관을 원문 기록으로 읽는 설정집. 신앙과 질서, 영생과 종족, 도시와 기억, 생명과 지식의 자료를 연결합니다.',editUrl:false,tableOfContents:false}}>
  <nav class="discovery-jump" aria-label="원문을 읽는 관점">{discoveryAxes.map(a=><a href={href(a.id==='faction'?'세력.html':'관점/'+a.id+'.html')}><strong>{a.name}</strong><span>{a.question}</span><span>{allDiscoveryGroups.reduce((n,g)=>n+g.items.filter(item=>item.axis===a.id).length,0)}개 본문 →</span></a>)}</nav>
  <AtlasHub/>
  <a class="universe-entry" href="./우주.html"><span><strong>우주 콘텐츠와 아이템 이야기</strong><span>곤충 떼 재난 · 황금과 기계 · 인지 불가 영역 · 차분화 우주 · 기물과 아이템의 원문</span></span><span aria-hidden="true">→</span></a>
  <a class="universe-entry" href={href('도감.html')}><span><strong>도감과 새로 확인한 원문</strong><span>적 기록 · 업적 · 축복 · 추가 서적 · 펄의 이야기와 물품의 기록</span></span><span aria-hidden="true">→</span></a>
  <h2 id="essays">기록을 함께 읽기</h2>
  <nav class="shelf-nav" aria-label="설정집 주제">{shelves.map((s,i)=><a href={'#shelf-'+i}>{s.title}</a>)}</nav>
  {shelves.map((s,i)=><section class="topic-shelf" id={'shelf-'+i}><div class="shelf-heading"><h2>{s.title}</h2><p>{s.deck}</p></div><div class="topic-grid">{s.ids.map(id=>topics.find(t=>t.id===id)!).map(t=><a class="topic-card" href={topicUrl(t.id)}><span class="row-type">{t.world}</span><h3>{t.title}</h3><p>{t.deck}</p><div class="card-trail" aria-label="연결해서 읽는 흐름">{guides[t.id].trail.map((step,j)=><><span>{step}</span>{j<guides[t.id].trail.length-1&&<span aria-hidden="true">→</span>}</>)}</div><span class="topic-meta">{t.sources.length}개 근거·추천 원문 <span aria-hidden="true">→</span></span></a>)}</div></section>)}
  <h2 id="explorer-library">지역·인물·개념 찾아보기</h2><Explorer/>
  <h2 id="originals">원문 자료실</h2><p class="muted">서적·인물 기록·용어의 본문을 자료 종류별로 찾아 읽습니다.</p><Browse mode="settings"/>
</StarlightPage>
