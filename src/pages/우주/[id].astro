---
import {sourceDescription} from '../../lib/seo.mjs';
import {disclosureAttributes,sourceLinkAttributes} from '../../lib/reading-kit/reader.mjs';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import universe from '../../../data/universe-catalog.json';
import sources from '../../../data/universe-source-records.json';
import official from '../../../data/official-universe-texts.json';
import clusters from '../../../data/universe-reading-clusters.json';
import Scene from '../../components/Scene.astro';
import UniverseRecordIndex from '../../components/UniverseRecordIndex.astro';
import UniverseSourceDirectory from '../../components/UniverseSourceDirectory.astro';
import UniverseResearch from '../../components/UniverseResearch.astro';
import RecordIndex from '../../components/RecordIndex.astro';
import {href,doc,docUrl,missionDialogue} from '../../lib/data';
export function getStaticPaths(){return universe.modes.map(m=>({params:{id:m.id},props:{m}}));}
const {m}=Astro.props;
const originals=m.documents.map(r=>({ref:r,document:doc(r.id)}));
const research={"swarm-disaster":"swarm-research","gold-and-gears":"rupert-research","unknowable-domain":"unknowable-research"}[m.id];
const sourceRecords=sources.modes.find(mode=>mode.id===m.id)?.records||[];
const settingTexts=official.records.filter(record=>record.modeId===m.id);
const cluster=clusters.clusters.find(c=>c.modeId===m.id);
---
<StarlightPage frontmatter={{title:m.name,description:sourceDescription([m.name,'우주 콘텐츠 원문과 관련 기록',m.intro]),editUrl:false,tableOfContents:false}}>
 <nav class="breadcrumbs" aria-label="현재 위치"><a href={href('우주.html')}>우주 콘텐츠·아이템</a><span>/</span><span>{m.name}</span></nav>
 <p class="page-deck">{m.intro}</p><p class="muted">원문에 근거한 요약 · 아래 기록과 발언을 대조한 읽기 묶음</p>
 <details {...disclosureAttributes({className:'source-details'})}><summary>개요의 원문 근거 · {m.introEvidence.status}</summary><blockquote class="rw-quotation">{m.introEvidence.quote}</blockquote><a {...sourceLinkAttributes({reading:true})} href={href(m.introEvidence.url)}>{m.introEvidence.title} · 이 발언의 원문 ↗</a></details>
 <nav class="shelf-nav" aria-label="이 콘텐츠의 원문">{sourceRecords.length>0&&<a href="#source-records">이야기 기록 {sourceRecords.length}개</a>}{settingTexts.length>0&&<a href="#setting-texts">설정 원문 {settingTexts.length}개</a>}{cluster&&<a href="#research">설정과 기록의 연결</a>}<a href="#core-records">핵심 원문</a>{m.dialogueGroups.length>0&&<a href="#mode-dialogue">대사 원문</a>}<a href="#related-records">관련 용어의 기록</a></nav>
 {sourceRecords.length>0&&<section id="source-records" class="universe-source-shelf"><UniverseSourceDirectory records={sourceRecords} modeId={m.id} modeName={m.name}/></section>}
 {settingTexts.length>0&&<section id="setting-texts" class="universe-source-shelf"><header class="rw-index-heading"><h2>{m.id==='divergent-universe'?'방정식·기물·수집품의 원문':'이 콘텐츠의 설정 원문'}</h2><p>이야기, 명칭, 게임 효과와 조건을 항목별로 읽는다. 한국어 본문은 4.6 수록 문구다.</p></header><UniverseRecordIndex records={settingTexts} modeName={m.name} queryKey="textQuery" limitKey="textLimit" kindKey="textKind"/></section>}
 {cluster&&<UniverseResearch cluster={cluster}/>}
 {research&&<a class="universe-entry" href={href('맥락/'+research+'.html')} data-reading-link><strong>연구 대상·관측자·다른 기록을 함께 읽기</strong><span>관계와 관점 비교 →</span></a>}
 <section id="core-records" class="mode-reading-path"><h2>핵심 원문을 이어 읽기</h2><p class="muted">설명·사건·사물의 기록을 함께 읽는 편집 순서입니다.</p><ol>{originals.map(({ref,document},i)=><li><a href={'#record-'+ref.id}><span class="mode-path-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span><small>{ref.category}</small><strong>{ref.title}</strong></span><span aria-hidden="true">↓</span></a></li>)}</ol></section>
 {m.dialogueGroups.length>0&&<section id="mode-dialogue"><h2>이 콘텐츠를 설명하는 대사 원문</h2><p class="muted">주제별로 대조한 대사 표의 행을 함께 읽습니다. 선택지와 응답을 보존했으며 각 묶음은 편집 독서 순서입니다.</p><nav class="shelf-nav" aria-label="대사 주제">{m.dialogueGroups.map(g=><a href={'#dialogue-'+g.id}>{g.title} · {g.count}개</a>)}</nav>{m.dialogueGroups.map(g=><section class="mode-dialogue-group" id={'dialogue-'+g.id}><p class="eyebrow">{g.status}</p><Scene section={{anchor:'dialogue-text-'+g.id,title:g.title,source:'TalkSentenceConfig · 한국어 TextMap',mapping:'LOCAL_TABLE',directTalkAnchors:true,rows:g.rows}} quest/><a href={href(g.url)} {...sourceLinkAttributes({reading:true})}>전체 대사 표에서 원문 확인 ↗</a></section>)}</section>}
 <div class="mode-originals">{originals.map(({ref,document})=><section id={'record-'+ref.id} class="mode-original"><header><p class="eyebrow">{ref.category} · 원문</p><h2>{ref.title}</h2><a href={docUrl(ref.id)} {...sourceLinkAttributes({reading:true})}>개별 원문과 출처 ↗</a>{missionDialogue[ref.id]?.length>0&&<a href={docUrl(ref.id)+'#linked-dialogue'} {...sourceLinkAttributes({reading:true})}>이 임무의 대사 원문 {missionDialogue[ref.id].reduce((count,s)=>count+s.rows.length,0).toLocaleString()}행 →</a>}</header>{document.sections.map((s,i)=><Scene section={{...s,anchor:ref.id+'-'+s.anchor}} quest={document.category==='퀘스트'}/>)}</section>)}</div>
 <section id="related-records"><header class="rw-index-heading"><h2>관련 용어가 등장하는 기록</h2><p>본문 검색 결과 · 이름이 등장하는 문장과 주변 기록</p></header><RecordIndex records={m.relatedRecords}/></section>
 <nav class="shelf-nav" aria-label="다른 콘텐츠로 읽기">{universe.modes.filter(x=>x.id!==m.id).map(x=><a href={href('우주/'+x.id+'.html')} data-reading-link>{x.name}</a>)}</nav>
</StarlightPage>
