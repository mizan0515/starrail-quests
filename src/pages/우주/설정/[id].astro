---
import {sourceDescription} from '../../../lib/seo.mjs';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import official from '../../../../data/official-universe-texts.json';
import sources from '../../../../data/universe-source-records.json';
import universe from '../../../../data/universe-catalog.json';
import SourceParagraphs from '../../../components/SourceParagraphs.astro';
import CatalogReturn from '../../../components/CatalogReturn.astro';
import {href} from '../../../lib/data';
import {readerAttributes,rowAttributes,disclosureAttributes,sourceLinkAttributes} from '../../../lib/reading-kit/reader.mjs';
import {renderCvaModule} from '../../../lib/reading-kit/cva.mjs';
export function getStaticPaths(){return official.records.map(record=>({params:{id:record.id},props:{record}}));}
const {record}=Astro.props;
const mode=universe.modes.find(item=>item.id===record.modeId);
const all=sources.modes.flatMap(item=>item.records);
const linked=record.linkedSourceRecordIds.map(id=>all.find(item=>item.id===id)).filter(Boolean);
const metaUrl=path=>`https://github.com/DimbreathBot/TurnBasedGameData/blob/${official.evidence.metadataCommit}/${path}`;
const fields=[...record.fields].sort((a,b)=>Number(b.role==='story')-Number(a.role==='story'));
const fieldAnchor=field=>record.id+'-'+field.fieldKey;
---
<StarlightPage frontmatter={{title:record.title,description:sourceDescription([record.title,mode.name,record.kindLabel,'한국어 수록본 4.6'],fields.find(field=>field.role==='story')?.text||fields[0]?.text),editUrl:false,tableOfContents:false}}>
 <CatalogReturn/>
 <nav class="breadcrumbs" aria-label="현재 위치"><a href={href('우주.html')}>우주 콘텐츠·아이템</a><span>/</span><a href={href('우주/'+record.modeId+'.html#setting-texts')}>{mode.name}</a><span>/</span><span>{record.kindLabel}</span></nav>
 <p class="document-meta"><span class="kind-badge">{record.kindLabel} · 원문</span><span>한국어 수록본 4.6</span></p>
 {record.names?.length>0&&<details {...disclosureAttributes({className:'source-details'})} data-pagefind-ignore data-official-title-proof><summary>명칭의 원문 근거</summary>{record.names.map(name=><div><p><strong>{name.text}</strong></p><dl><dt>명칭 원문</dt><dd><a href={metaUrl(name.sourceTable)} {...sourceLinkAttributes({variant:'inline'})}>{name.sourceTable} ↗</a> · {name.sourcePointer}</dd><dt>한국어 문자열</dt><dd>4.6 · {name.textmapHash} · TextMap {name.offset}–{name.end}</dd><dt>이 항목과 명칭의 연결</dt><dd><ol>{name.proof.map(step=><li><a href={metaUrl(step.sourceTable)} {...sourceLinkAttributes({variant:'inline'})}>{step.sourceTable} ↗</a> · {step.pointer} · {step.value}</li>)}</ol></dd></dl><pre class="official-source-raw"><code>{name.raw}</code></pre></div>)}</details>}
 <nav class="shelf-nav" aria-label="이 자료의 원문 항목">{fields.map(field=><a href={'#'+fieldAnchor(field)}>{field.label}</a>)}{linked.length>0&&<a href="#linked-records">연결된 대사·연출</a>}</nav>
 <div class="universe-record-original" id="original">{fields.map(field=><section {...readerAttributes({variant:'scene',className:'source-section',id:fieldAnchor(field)})} data-official-text-field={field.fieldKey}>
   <Fragment set:html={renderCvaModule({id:'cva-'+fieldAnchor(field).replace(/[^A-Za-z0-9_-]/g,'-').slice(0,59),type:'text',variant:'prose',props:{title:field.label,body:'',eyebrow:record.kindLabel+' · 원문'}})}/>
   <div {...rowAttributes('dialogue')} class="rw-source-row original-row"><SourceParagraphs text={field.text} anchor={fieldAnchor(field)+'-body'}/></div>
   <details {...disclosureAttributes({className:'source-details'})} data-pagefind-ignore><summary>이 항목의 원문과 출처</summary><dl>
    <dt>명칭·설명의 참조</dt><dd><a href={metaUrl(field.sourceTable||record.sourceTable)} {...sourceLinkAttributes({variant:'inline'})}>{field.sourceTable||record.sourceTable} ↗</a> · {field.sourcePointer}</dd>
    <dt>한국어 문자열</dt><dd>4.6 · {field.textmapHash}</dd>
    <dt>원문 위치</dt><dd>TextMap · {field.offset}–{field.end}</dd>
    <dt>한국어 자료 SHA-256</dt><dd>{official.evidence.koreanPack.sha256}</dd>
   </dl><p>게임 자료에 수록된 표기</p><pre class="official-source-raw"><code>{field.raw}</code></pre></details>
  </section>)}</div>
 {linked.length>0&&<section id="linked-records"><header class="rw-index-heading"><h2>{record.kind==='formula'?'같은 방정식의 대화·연출':'이 기록에 연결된 대사'}</h2><p>{record.kind==='formula'?'방정식 표의 같은 표시 식별자로 연결된 원문이다.':'같은 자료 항목에 수록된 대사 원문이다.'}</p></header><div class="universe-related-reading">{linked.map(item=><a href={href('우주/기록/'+item.id+'.html')} data-reading-link><strong>{item.title}</strong><span>대사·선택지 {item.scenes.reduce((count,scene)=>count+scene.rows.length,0)}행</span><span aria-hidden="true">→</span></a>)}</div><details {...disclosureAttributes({className:'source-details'})} data-pagefind-ignore><summary>기록이 이어지는 근거</summary><dl>{record.references.map(reference=><><dt>{reference.kind==='EXPLICIT_FORMULA_DISPLAY_ID'?'같은 방정식의 표시 식별자':'같은 자료 항목'}</dt><dd><a href={metaUrl(reference.sourceTable)} {...sourceLinkAttributes({variant:'inline'})}>{reference.sourceTable} ↗</a> · {reference.sourcePointer} · {reference.value}<br/><a href={metaUrl(reference.targetTable)} {...sourceLinkAttributes({variant:'inline'})}>{reference.targetTable} ↗</a> · {reference.targetPointer}</dd></>)}</dl></details></section>}
 <nav class="universe-record-neighbours" aria-label="이 자료의 목록"><a href={href('우주/'+record.modeId+'.html#setting-texts')}><small>설정 원문 목록</small><strong>{mode.name}</strong></a></nav>
</StarlightPage>
