---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import UniverseRecordIndex from '../../components/UniverseRecordIndex.astro';
import SourceParagraphs from '../../components/SourceParagraphs.astro';
import CatalogReturn from '../../components/CatalogReturn.astro';
import {contexts,contextRows,contextRegions} from '../../lib/dialogue-contexts';
import {href,missionSourceNotice} from '../../lib/data';
import {sourceDescription} from '../../lib/seo.mjs';
import {readerAttributes,rowAttributes,disclosureAttributes} from '../../lib/reading-kit/reader.mjs';
export function getStaticPaths(){const kinds=[...new Set(contexts.groups.map(g=>g.kind))];const directories=kinds.flatMap((kind,i)=>{const all=contexts.groups.filter(g=>g.kind===kind),pages=Math.ceil(all.length/120);return Array.from({length:pages},(_,part)=>({params:{id:'목록-'+i+(part?'-'+part:'')},props:{kind,kindId:i,part,pages,total:all.length,groups:all.slice(part*120,(part+1)*120)}}));});return [...directories,...contexts.groups.map(group=>({params:{id:group.id},props:{group}}))];}
const {group,groups,kind,kindId,part,pages,total}=Astro.props;
const rows=group?contextRows(group):[];
const regions=group?contextRegions(group):[];
const records=groups?.map(g=>({id:g.id,title:g.title,kind:[...new Set(contextRegions(g).map(r=>r.world))].join(' · ')||'지역 연결 확인 중',scenes:[{rows:contextRows(g)}],searchText:[...contextRows(g).map(r=>r.speaker),...contextRegions(g).map(r=>r.name)].join(' '),url:href('대화/'+g.id+'.html')}));
const url=source=>`https://github.com/${contexts.evidence.repository}/blob/${contexts.evidence.commit}/${source}`;
---
<StarlightPage frontmatter={{title:group?group.title:kind,description:group?sourceDescription([group.kind,...regions.map(r=>r.name),`${rows.length}개 한국어 대사`],rows[0].text):`${kind}의 한국어 대화와 선택지를 구절과 화자로 찾아 원문에서 읽습니다.`,editUrl:false,tableOfContents:false}}>
 <CatalogReturn/>
 <nav class="breadcrumbs" aria-label="현재 위치"><a href={href('대사.html')}>대사 원문 자료실</a><span>/</span><a href={href('대화.html')}>장면으로 읽는 대화</a>{group&&<><span>/</span><a href={href('대화/목록-'+[...new Set(contexts.groups.map(g=>g.kind))].indexOf(group.kind)+'.html')}>{group.kind}</a></>}</nav>
 {group?<>
  <p class="document-meta"><span class="kind-badge">{group.kind}</span><span>{rows.length}개 원문</span>{regions.map(r=><span>{r.world} · {r.name}</span>)}</p>
  <p class="muted" data-publication-ui="source-context">{group.source.startsWith('ExcelOutput/')?'이 콘텐츠 설정표에 기록된 한국어 문구입니다. 문구별 대상과 조건은 연결 근거에서 확인할 수 있습니다. 아래 배열은 표의 참조 순서입니다.':'같은 사용 장면에서 참조하는 원문입니다. 선택과 조건에 따라 읽는 문구가 달라질 수 있으며, 아래 배열은 구조의 참조 순서입니다.'}</p>
  {group.unavailableTalkIds.length>0&&<p class="muted">이 장면에서 참조하는 문구 중 {group.unavailableTalkIds.length}개의 한국어 본문 연결은 확인 중입니다.</p>}
  <section {...readerAttributes({variant:'scene',className:'source-section',id:'original'})} data-dialogue-context={group.id}>
   {rows.map(row=><div {...{...rowAttributes(row.isChoice?'choice':'dialogue'),class:['rw-source-row','original-row',row.isChoice&&'choice'].filter(Boolean).join(' ')}} data-context-talk={row.talk_id} data-passage={row.isChoice?'choice':'dialogue'} data-speaker={row.speaker}>
    <span class="speaker rw-source-speaker">{missionSourceNotice(row)?'원문에 수록된 제작 안내':row.isConfigurationReference?(row.speaker==='화자 미지정'?'설정 참조':'설정 참조 · '+row.speaker):row.isChoice?(row.isDialogue?'선택지·대사 · '+row.speaker:'선택지'):row.speaker==='화자 미지정'?'원문':row.speaker}</span>
    {row.usageLabels.length>0&&<span class="kind-badge" data-context-usage={row.usageLabels.join(' · ')}>{row.usageLabels.join(' · ')}</span>}
    {row.targetRegions.length>0&&<p class="branch-note" data-context-target-regions={row.targetRegions.map(r=>r.floorId).join(',')}>설정표의 대상 지역: {row.targetRegions.map(r=>r.world+' · '+r.name).join(' / ')}</p>}
    <SourceParagraphs text={row.text} anchor={'talk-'+row.talk_id}/>
    <a href={href(row.url)} data-reading-link>대사표 원문 ↗</a>
   </div>)}
  </section>
  <details {...disclosureAttributes({className:'source-details'})} data-pagefind-ignore id="verified-sources"><summary>사용 장면과 원문의 연결 근거</summary><dl><dt>원문을 참조하는 구조</dt><dd><a href={url(group.source)}>{group.source}</a></dd><dt>구조 SHA-256</dt><dd>{group.sourceSha256}</dd></dl>{group.configurationProof&&<div data-configuration-consumer={group.configurationProof.schema}><h2>대체 음성 설정의 연결</h2><p>본문 ID와 대체 음성 목록은 같은 설정표 행에 연결됩니다. 아래 원문 행에서 본문 ID와 음성 목록을 따로 확인할 수 있습니다. 발화 시점과 임무 연결은 확인 중입니다.</p><dl><dt>문구를 조회하는 함수</dt><dd>{group.configurationProof.consumer.method}</dd><dt>본문과 음성의 필드</dt><dd>TalkSentenceID → 본문 ID · VoiceIDList → 대체 음성 목록</dd><dt>자료표와 함수의 직접 참조</dt><dd><pre>{JSON.stringify({nativeSource:group.configurationProof.nativeSource,binding:group.configurationProof.binding,consumer:group.configurationProof.consumer},null,2)}</pre></dd></dl></div>}<ul>{group.rows.map(r=><li>대사 {r.talkId} · {r.edition==='official'?'공식 4.6 수록본':'보존된 로컬 한국어 수록본'}<ul>{r.references.map(ref=><li>{ref.kind} · {ref.pointer}{ref.recordContext&&<pre data-native-source-record={ref.recordContext.pointer} data-native-talk-id={r.talkId}>{ref.recordContext.serialized}</pre>}{ref.conditions.length>0&&<pre>{JSON.stringify(ref.conditions,null,2)}</pre>}</li>)}</ul></li>)}</ul>{group.regions.map(r=><div><h2>{contexts.regions[String(r.floorId)].name} · 지역 연결</h2><ul>{[...contexts.regions[String(r.floorId)].proof,...r.chain].map(edge=><li><a href={url(edge.source)}>{edge.source}</a> · {edge.pointer}<br/>{edge.target||String(edge.value)}<br/>SHA-256 {edge.sourceSha256}{edge.tableSource&&<><br/><a href={url(edge.tableSource)}>{edge.tableSource}</a> · {edge.idPointer} → {edge.pathPointer}<br/>SHA-256 {edge.tableSha256}</>}</li>)}</ul></div>)}</details>
 </>:<>
  <p class="page-deck">{total.toLocaleString('ko-KR')}개 사용 장면 중 {part*120+1}–{Math.min(total,(part+1)*120)}번째. 이 목록에서 화자와 구절을 찾아 읽거나, 상단 검색에서 전체 원문을 찾을 수 있습니다.</p>
  <UniverseRecordIndex records={records} modeName={kind} queryKey="contextQuery" limitKey="contextLimit" kindKey="contextWorld" searchLabel="현재 목록의 화자·원문 구절" searchPlaceholder="읽고 싶은 문구나 인물 이름"/>
  {pages>1&&<nav class="reading-next" aria-label="다음 장면 목록">{part>0&&<a href={href('대화/목록-'+kindId+(part>1?'-'+(part-1):'')+'.html')} data-reading-link><span>앞선 목록</span><strong>{part} / {pages}</strong></a>}{part+1<pages&&<a href={href('대화/목록-'+kindId+'-'+(part+1)+'.html')} data-reading-link><span>다음 목록</span><strong>{part+2} / {pages}</strong></a>}</nav>}
 </>}
</StarlightPage>
<script>
 const directory=document.querySelector<HTMLElement>('[data-universe-records][data-query-key="contextQuery"]');
 if(directory){
  const restore=()=>requestAnimationFrame(()=>{
   let id:string;try{id=decodeURIComponent(location.hash.slice(1));}catch{return;}
   const link=document.getElementById(id);
   // Directory filtering runs first. Preserve its query and expanded limit;
   // a hash never reveals an entry excluded by that restored state.
   if(!(link instanceof HTMLAnchorElement)||!link.hasAttribute('data-reading-link')||link.closest('[hidden]'))return;
   link.scrollIntoView({block:'center'});link.focus({preventScroll:true});
  });
  restore();window.addEventListener('pageshow',restore);window.addEventListener('hashchange',restore);
 }
</script>
