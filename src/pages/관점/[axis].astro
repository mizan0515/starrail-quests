---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AtlasHub from '../../components/AtlasHub.astro';
import Explorer from '../../components/Explorer.astro';
import {axes} from '../../lib/explorer';
import {atlas} from '../../lib/atlas';
import {href} from '../../lib/data';
export function getStaticPaths(){return axes.map(axis=>({params:{axis:axis.id},props:{axis}}));}
const {axis}=Astro.props;
---
<StarlightPage frontmatter={{title:`${axis.name}에서 읽는 설정`,description:axis.question,editUrl:false,tableOfContents:false}}>
 <nav class="breadcrumbs" aria-label="현재 위치"><a href={href('설정집.html')}>설정집</a><span>/</span><span>{axis.name}</span></nav>
 <Explorer axis={axis.id}/>
 {axis.id!=='aeon'&&<details class="curated-disclosure"><summary>관계·사건을 엮은 해설 경로</summary><AtlasHub axis={axis.id}/></details>}
 <a class="dossier-essay-link" href={href('설정집.html#essays')}><strong>질문으로 묶은 해설과 전체 원문 자료실</strong><span>서적·캐릭터·용어·유물의 원문을 더 찾아 읽기 →</span></a>
</StarlightPage>
