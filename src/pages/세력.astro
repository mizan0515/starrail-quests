---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import GroupedDirectory from '../components/GroupedDirectory.astro';
import {allDiscoveryGroups} from '../lib/discovery';
---
<StarlightPage frontmatter={{title:'세력',description:'군대·조직·단체의 목적, 신앙과 활동을 원문 소개와 열차 파벌 아카이브에서 읽습니다.',editUrl:false,tableOfContents:false}}>
 <GroupedDirectory id="factions" title="조직과 단체의 기록" lead="군대의 목적, 단체의 신앙, 연구와 교역의 기록을 내용별로 찾습니다. 각 조직의 소개 원문과 열차 아카이브, 관련 사건을 정리한 설명으로 이동할 수 있습니다." groups={allDiscoveryGroups.map(g=>({...g,items:g.items.filter(item=>item.axis==='faction')})).filter(g=>g.items.length)} queryKey="find" groupKey="group" limitKey="entityLimit" placeholder="예: 축성가, 혼돈의 의사, 스텔라론 헌터"/>
</StarlightPage>
