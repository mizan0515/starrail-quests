---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import GroupedDirectory from '../components/GroupedDirectory.astro';
import handbook from '../../data/handbook-originals.json';
import {handbookDirectoryGroups} from '../lib/handbook-originals.mjs';
import {doc,docUrl,href} from '../lib/data';
const groups=handbookDirectoryGroups(handbook,doc,docUrl);
---
<StarlightPage frontmatter={{title:'도감과 새로 확인한 원문',description:'적 기록·업적·축복과 새로 확인한 서적·인물·아이템 원문을 이름이나 구절로 찾아 읽습니다.',editUrl:false,tableOfContents:false}}>
 <p class="page-deck">적의 소개, 업적의 문구, 축복·메아리의 설명과 서적·인물·물품의 새 원문을 함께 읽습니다.</p>
 <p class="muted">적·업적·축복·메아리는 고정된 구조 자료의 항목을 공식 4.6 한국어 원문에 연결했습니다. 구조 자료와 한국어의 관찰 버전은 각 본문에 구분했습니다. 게임 내 도감의 현재 전체 목록과 항목 수는 확인 중입니다.</p>
 <GroupedDirectory id="handbook" title="자료 종류별로 찾아 읽기" groups={groups} note="같은 명칭의 표 항목은 한 카드에서 찾습니다. 본문에서 각 항목의 식별자와 원문 변형으로 이동할 수 있습니다."/>
 <p><a href={href('설정집.html')}>설정집과 기존 원문 자료실로 돌아가기 →</a></p>
</StarlightPage>
