---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import guides from '../../../editorial/reading-guides.json';
import Perspectives from '../../components/Perspectives.astro';
import SourceRegister from '../../components/SourceRegister.astro';
import {atlas,atlasUrl,axisName} from '../../lib/atlas';
import {topics,doc,docUrl,href,topicUrl} from '../../lib/data';
import {readingGraph} from '../../lib/reading-data';
import {createReadingKit,escapeHtml as E,cvaId} from '../../lib/reading-kit/render.mjs';
import {sourceLink} from '../../lib/reading-kit/reader.mjs';
export function getStaticPaths(){return topics.map(t=>({params:{id:t.id},props:{topic:t}}));}
const t=Astro.props.topic;
const connections={
 'paths-and-factions':[['xianzhou-immortality','신앙은 고정되어 있을까? 선주의 변화를 이어 읽기']],
 'xianzhou-immortality':[['borisin-and-foxians','장수와 풍요의 문제를 종족·전쟁의 기록으로 넓히기'],['paths-and-factions','같은 운명의 길과 서로 다른 조직을 구분하기']],
 'borisin-and-foxians':[['xianzhou-immortality','보리인을 바라보는 선주의 역사적 배경 읽기'],['belobog-preservation','병사용 보고서와 주민의 기록이 다르게 말하는 이유 비교하기']],
 'belobog-preservation':[['penacony-memory','공식 역사는 누구의 목소리를 남기는가 비교하기']],
 'penacony-memory':[['belobog-preservation','도시의 공식 기록과 주민의 경험을 비교하기']],
 'amphoreus-myth-and-life':[['herta-life-and-knowledge','신앙과 지식의 논쟁을 실험과 감정의 문제와 비교하기']],
 'herta-life-and-knowledge':[['amphoreus-myth-and-life','세계를 설명하는 학파의 여러 목소리 이어 읽기']],
};
const originalUrl=e=>{
 const d=doc(e.id),section=d.sections.find(s=>s.anchor===e.anchor);
 const matches=section?.rows.map((r,i)=>({r,i})).filter(({r})=>String(r.hash)===String(e.hash)&&r.text.includes(e.quote))||[];
 if(matches.length!==1)throw Error('Topic original citation differs: '+e.id);
 return docUrl(e.id)+'#'+e.anchor+'-row-'+(matches[0].i+1);
};
const kit=createReadingKit({evidence:items=>items.map(e=>`<div data-topic-evidence="${E(e.id)}"><blockquote class="rw-quotation">${E(e.quote)}</blockquote>${sourceLink(originalUrl(e),e.title+' · 해당 구절 ↗',{reading:true})}</div>`).join('')});
const endpoint=name=>{
 const candidates=readingGraph.entities.filter(n=>n.name===name);
 const node=candidates.length===1?candidates[0]:null;
 return {id:node?.id||cvaId('topic-entity',name),name,...(node?{url:node.url}:{})};
};
const relations=t.relations.map(([actor,predicate,target,source],i)=>{
 const proof=t.relationEvidence[i];
 return {id:'relation-'+i,from:endpoint(actor),to:endpoint(target),label:predicate,reasonClaimId:t.id+'-relation-'+i,
 reason:proof.reason,kind:proof.statementType,claimKind:proof.statementType,speaker:proof.speaker,evidence:proof.evidence};
});
const headings=[...t.sections.map((s,i)=>({depth:2,slug:'reading-'+i,text:s.title})),{depth:2,slug:'perspectives',text:'기록의 관점 비교'},{depth:2,slug:'relations',text:'관계 한눈에 보기'},{depth:2,slug:'sources',text:'추천 읽기 순서'},{depth:2,slug:'verified-sources',text:'확인한 원문과 근거'}];
---
<StarlightPage headings={headings} frontmatter={{title:t.title,description:t.deck,editUrl:false}}>
  <nav class="breadcrumbs" aria-label="현재 위치" data-pagefind-ignore><a href={href('설정집.html')}>설정집</a><span>/</span><span>{t.world}</span></nav>
  <p class="page-deck">{t.deck}</p>
  <div class="essay-meta"><span class="kind-badge">편집자 해설</span><span>{t.sources.length}개 근거·추천 원문</span><a href="#sources">원문부터 읽기 ↓</a></div>
  <nav class="essay-lenses" aria-label="같은 설정을 다른 관점에서 읽기">{atlas.nodes.filter(n=>n.topic===t.id).map(n=><a href={atlasUrl(n.id)} data-reading-link><span>{axisName(n.axis)}</span><strong>{n.name}</strong><span aria-hidden="true">↗</span></a>)}</nav>
  <nav class="essay-map" aria-label="해설 읽는 흐름">{t.sections.map((section,i)=><a href={"#reading-"+i}><span>{String(i+1).padStart(2,"0")}</span><strong>{guides[t.id].trail[i]||section.title}</strong><span aria-hidden="true">↓</span></a>)}</nav>
  <details class="editor-note"><summary>편집자 해설 · 근거는 원문에서 확인하세요</summary><p>아래 글은 기록을 함께 읽은 편집자의 해석입니다. 게임 원문은 근거 카드와 추천 목록에서 직접 확인할 수 있습니다. 이야기의 주요 설정이 포함되어 있습니다.</p></details>
  {t.sections.map((s,i)=><div class="essay-section"><Fragment set:html={kit.section({id:'reading-'+i,title:s.title,items:[{text:s.text,kind:'inference',evidence:s.evidence}]})}/></div>)}
  <Perspectives topic={t.id}/>
  <AnchorHeading level={2} id="relations">관계 한눈에 보기</AnchorHeading>
  <div class="named-relations" data-topic-relations={t.id}><Fragment set:html={kit.network(relations,{id:'topic-'+t.id,title:'관계 한눈에 보기'})}/></div>
  <aside class="interpretation-note"><strong>읽을 때 구분할 점</strong><p>{t.caution}</p></aside>
  <AnchorHeading level={2} id="sources">추천 읽기 순서</AnchorHeading>
  <div class="reading-list"><Fragment set:html={kit.directory(t.reading.map(r=>({name:r.title,url:docUrl(r.id),summary:r.why,kind:'추천 원문'})))}/></div>
  <aside class="related-panel" data-pagefind-ignore><h2>질문을 이어서 읽기</h2><p class="muted">같은 설정이라는 뜻이 아니라, 서로 비춰 읽을 만한 질문을 연결했습니다.</p><div>{connections[t.id]?.map(([id,why])=><a href={topicUrl(id)}><strong>{topics.find(x=>x.id===id)?.title}</strong><span>{why}</span><span aria-hidden="true">→</span></a>)}</div></aside>
  <SourceRegister entries={[...t.sections.flatMap(s=>s.evidence),...atlas.comparisons[t.id].panels.map(p=>p.evidence),...t.relationEvidence.flatMap(p=>p.evidence)]}/>
</StarlightPage>
