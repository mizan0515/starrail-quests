---
import {sourceDescription} from '../../lib/seo.mjs';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Browse from '../../components/Browse.astro';
import {kinds} from '../../lib/data';
export function getStaticPaths(){return Object.entries(kinds).map(([key,name])=>({params:{kind:key},props:{name}}));}
const {name}=Astro.props;
---
<StarlightPage frontmatter={{title:name,description:sourceDescription(['붕괴: 스타레일',name,'한국어 임무 목록·대사·선택지·진행 목표']),editUrl:false,tableOfContents:false}}><p class="page-deck">{name==='개척 임무'?'은하열차의 여정을 처음부터 다시 읽습니다.':name==='개척 후문'?'다녀온 세계에서 이어지는 이야기를 읽습니다.':name==='동행 임무'?'인물의 선택과 과거를 따라 읽습니다.':name==='모험 임무'?'세계 곳곳에서 마주친 사람들의 이야기를 읽습니다.':'일상 속 짧은 이야기를 다시 찾습니다.'}</p><Browse kind={name}/></StarlightPage>
