---
import {documentDescription} from '../../lib/seo.mjs';
import {disclosureAttributes} from '../../lib/reading-kit/reader.mjs';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import Scene from '../../components/Scene.astro';
import MissionReader from '../../components/MissionReader.astro';
import CatalogReturn from '../../components/CatalogReturn.astro';
import HandbookOriginalProof from '../../components/HandbookOriginalProof.astro';
import {catalog,doc,docUrl,topicUrl,href,versionEvidence,missionDialogue,missionReading,missionMessages,missionCoverage,missionSectionLinked} from '../../lib/data';
import aliases from '../../../data/aliases.json';
import relicBackgrounds from '../../../data/relic-backgrounds.json';
export function getStaticPaths(){return [...catalog.map(d=>({params:{id:d.id}})),...Object.keys(aliases).map(id=>({params:{id}}))];}
if(aliases[Astro.params.id!])return Astro.redirect(encodeURI(docUrl(aliases[Astro.params.id!])),301);
const d=doc(Astro.params.id!),quest=d.category==='퀘스트';
const supplements=quest?missionDialogue[d.id]||[]:[],reading=missionReading[d.id];
const observedVersion=versionEvidence.firstObservedVersions[d.id],release=versionEvidence.releaseEvidence[d.id];
const stageGroups:any[]=[];
for(const step of d.stages){const last=stageGroups.at(-1);if(last?.title===step.title)last.steps.push(step);else stageGroups.push({...step,steps:[step]});}
const headings=[{depth:2,slug:'original',text:quest?'대사와 선택지':'원문 읽기'},...(d.stages.length?[{depth:2,slug:'progress',text:'임무의 흐름'}]:[]),...(d.topics.length?[{depth:2,slug:'connections',text:'관련 설정 읽기'}]:[])];
const peers=d.collection?catalog.filter(x=>x.collection===d.collection&&x.id!==d.id):[];
const variants=(d.sameTitleDocumentIds||[]).filter(id=>id!==d.id).map(id=>catalog.find(x=>x.id===id)!);
const handbookSections=d.sections.filter(s=>s.handbookProof);
const backgrounds=relicBackgrounds.records.filter(r=>r.relatedItemIds.includes(d.id));
const next=d.next?catalog.find(x=>x.id==='quest-'+d.next):null;
const previous=quest?catalog.filter(x=>x.category==='퀘스트'&&x.kind===d.kind&&x.world===d.world&&x.chapter===d.chapter&&x.rank<d.rank).sort((a,b)=>b.rank-a.rank)[0]:null;
---
<StarlightPage headings={headings} frontmatter={{title:d.title,description:documentDescription(d,reading),editUrl:false}}>
 <CatalogReturn/>
 <nav class="breadcrumbs" aria-label="현재 위치" data-pagefind-ignore><a href={href(quest?'index.html':'설정집.html')}>{quest?'임무':'설정집'}</a><span>/</span><span>{d.kind||d.category}</span>{d.world!=='분류 미확인'&&<><span>/</span><span>{d.world}</span></>}</nav>
 {quest&&d.chapter!=='챕터 미지정'&&<p class="chapter-name">{d.chapter}</p>}
 <div class="document-meta" data-pagefind-ignore><span class="kind-badge">{d.kind||d.category}</span>{quest?<span>대사 {reading.dialogueCount.toLocaleString()}행 · 선택지 {reading.choiceCount.toLocaleString()}개{reading.captionCount>0&&<> · 영상 자막 {reading.captionCount.toLocaleString()}행</>}</span>:<span>{d.count.toLocaleString()}개 원문 항목</span>}{d.aliases.length>0&&<span>{d.missionParts?'임무 진행 조각':'동일 본문'} {d.aliases.length+1}개 통합</span>}<a class="jump-link" href="#original">{quest?'원문 읽기 ↓':'원문으로 이동 ↓'}</a></div>
 {quest&&observedVersion&&<p class="document-meta" data-pagefind-ignore><a href={href(`versions/${observedVersion}.html`)}>임무 표에서 확인 · {observedVersion}</a>{release&&<><a href={href(`versions/${release.version}.html`)}>출시 확인 · {release.version}</a>{release.sources.map(s=><a href={s.url}>{s.title} ↗</a>)}</>}</p>}
 {handbookSections.length>0&&<p class="muted" data-pagefind-ignore>추가 원문 · 공식 4.6 한국어. {handbookSections.some(s=>s.handbookProof.kind==='PINNED_METADATA_HASH_REFERENCE')||d.titleProof?.handbookSource.kind==='PINNED_METADATA_HASH_REFERENCE'?'표 항목의 구조는 별도로 고정된 자료에서 확인했습니다. 각 항목의 관찰 범위는 출처에 표시합니다.':'기존 본문을 보존하면서 별도로 확인한 표 항목을 추가했습니다.'}</p>}
 {d.titleProof&&<HandbookOriginalProof row={d.titleProof}/>}
 {variants.length>0&&<details class="collection-panel" data-pagefind-ignore><summary>같은 명칭의 다른 표 항목 · {variants.length}개</summary><p>각 표 식별자의 원문을 따로 보존했습니다. 같은 명칭만으로 개체나 종족의 동일성을 판단하지 않습니다.</p><ul>{variants.map(v=><li><a href={docUrl(v.id)} data-reading-link>{v.title} · {v.id}{v.recordLevel!==undefined&&` · 레벨 ${v.recordLevel}`}</a></li>)}</ul></details>}
 {peers.length>0&&<aside class="collection-panel" data-pagefind-ignore><strong>{d.handbookGroup?'같은 자료 분류':'같은 세트'} · {d.collection}</strong><ul>{(d.handbookGroup?peers.slice(0,24):peers).map(p=><li><a href={docUrl(p.id)}>{p.title}</a></li>)}</ul>{d.handbookGroup&&peers.length>24&&<a href={href('도감.html?group='+d.handbookGroup)} data-reading-link>이 자료 종류의 전체 기록 찾기 →</a>}</aside>}
 {quest?<MissionReader document={d} supplements={supplements} messages={missionMessages[d.id]} coverage={missionCoverage[d.id]} reading={reading}/>:<><AnchorHeading level={2} id="original">원문 읽기</AnchorHeading>{d.sections.map(section=><Scene section={section}/>)}</>}
 {backgrounds.length>0&&<section class="related-panel" id="background-story"><h2>이 유물의 배경 이야기</h2><p class="muted">유물 표의 세트·부위와 물품 식별자가 연결되는 장문 원문입니다.</p>{backgrounds.map(r=><a href={href('유물/'+r.id+'.html')} data-reading-link><strong>{r.storyTitle}</strong><span>{r.text.slice(0,180)}</span><span>배경 이야기 원문 읽기 →</span></a>)}</section>}
 {d.stages.length>0&&<section class="mission-progress" aria-labelledby="progress">
  <AnchorHeading level={2} id="progress">임무의 흐름</AnchorHeading>
  <p class="muted">임무 설정에 기록된 목표와 선행 조건입니다. 선택·동시 경로는 각 단계에 표시합니다.</p>
  <ol class="progress-outline" data-pagefind-ignore>{stageGroups.map(s=><li><a href={'#stage-'+s.id}>{s.title}</a>{s.optional&&<span class="optional-badge">선택 경로</span>}</li>)}</ol>
  {stageGroups.map((s,i)=><details class:list={['stage','mission-stage',s.optional&&'optional-stage']} id={'stage-'+s.id}>
   <summary><span class="stage-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><strong>{s.title}</strong>{s.optional&&<span class="optional-badge">선택</span>}</summary>
   {s.steps.slice(1).map(step=><span id={'stage-'+step.id} aria-hidden="true"/>)}
   {[...new Set(s.steps.map(step=>step.description).filter(Boolean))].map(description=><p class="stage-context">{description}</p>)}
   {s.predecessors.length>0&&<p class="stage-predecessor" data-pagefind-ignore>앞선 조건: {[...new Set(s.predecessors.map(id=>d.stages.find(x=>x.id===id)?.title||'내부 진행 단계 완료'))].join(' · ')}</p>}
   {d.sections.filter(x=>s.steps.some(step=>step.id===x.stage)).length>0&&<nav class="mission-stage-scenes" aria-label="이 목표에 연결된 장면">{d.sections.filter(x=>s.steps.some(step=>step.id===x.stage)).map(section=><a href={'#'+section.anchor}>{missionSectionLinked(d.id,section)?'연결된 대사 장면 읽기 →':'같은 목표 번호의 참고 대화 →'}</a>)}</nav>}
   <details {...disclosureAttributes({className:'source-details'})} data-pagefind-ignore><summary>임무 단계 출처{s.steps.length>1&&` · 같은 목표 ${s.steps.length}개 진행 조건 통합`}</summary>{s.steps.map(step=><p>SubMission · {step.id} · 목표 문자열 {step.hash} · 설명 문자열 {step.description_hash}</p>)}<p>진행 조건: MissionInfo 보조 구조</p></details>
  </details>)}
 </section>}
 {d.topics.length>0&&<section class="related-panel" id="connections" data-pagefind-ignore><h2>관련 설정 읽기</h2><div>{d.topics.map(t=><a href={topicUrl(t.id)} data-reading-link><strong>{t.title}</strong><span>{t.reason}</span><span aria-hidden="true">→</span></a>)}</div></section>}
 {quest&&<nav class="reading-next" aria-label="이어서 읽기" data-pagefind-ignore>{previous&&<a href={docUrl(previous.id)}><span>앞선 자료</span><strong>{previous.title}</strong></a>}{next&&<a href={docUrl(next.id)}><span>다음 진행 참조</span><strong>{next.title}</strong></a>}</nav>}
</StarlightPage>
<script>
 function revealStage(){const id=decodeURIComponent(location.hash.slice(1));if(!id.startsWith('stage-'))return;const target=document.getElementById(id);if(!target)return;let parent:HTMLElement|null=target;while(parent){if(parent instanceof HTMLDetailsElement)parent.open=true;parent=parent.parentElement;}target.scrollIntoView({block:'start'});}
 window.addEventListener('hashchange',revealStage);revealStage();
</script>
