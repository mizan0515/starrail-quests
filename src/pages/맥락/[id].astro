---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Connections from '../../components/Connections.astro';
import Evidence from '../../components/Evidence.astro';
import Perspectives from '../../components/Perspectives.astro';
import SourceRegister from '../../components/SourceRegister.astro';
import {atlas,axisName,atlasUrl} from '../../lib/atlas';
import {atlasComparison} from '../../lib/atlas-comparison.mjs';
import {href,topicUrl,topics} from '../../lib/data';
import {readingCluster,readingKit} from '../../lib/reading-data';
export function getStaticPaths(){return atlas.nodes.map(node=>({params:{id:node.id},props:{node}}));}
const {node}=Astro.props;
const comparison=atlasComparison(atlas,node);
const reading=readingCluster(node.id);
const relationTitle=reading.relations.some(r=>r.claimKind!=='inference')?'관계 한눈에':'함께 읽을 기록';
const structuralClaims=new Set([reading.topology,...reading.views].filter(Boolean).flatMap(t=>t.edges.map(e=>e.claimId)));
const supplementalRelations=reading.topology&&!node.relationshipTitle?reading.relations.filter(r=>!structuralClaims.has(r.reasonClaimId)):[];
const headings=[{depth:2,slug:reading.topology?.id||'structure',text:reading.topology?.title||relationTitle},...(node.timeline.length?[{depth:2,slug:'moments',text:node.axis==='person'?'삶의 전환점':'기록 속 사건 흐름'}]:[]),{depth:2,slug:'perspectives',text:'기록의 관점 비교'},{depth:2,slug:'reading',text:'더 깊이 읽기'},{depth:2,slug:'verified-sources',text:'확인한 원문과 근거'}];
const essay=topics.find(t=>t.id===node.topic)!;
const sources=[...(node.topology?.edges.flatMap(e=>e.evidence)||[]),...node.evidence,...node.links.map(l=>l.evidence),...node.timeline.map(m=>m.evidence),...comparison.panels.map(p=>p.evidence)];
---
<StarlightPage headings={headings.filter(h=>(h.slug!=='perspectives'||comparison.panels.length>0)&&(h.slug!=='reading'||!node.focusedSources))} frontmatter={{title:node.name,description:node.question,editUrl:false}}>
 <nav class="breadcrumbs" aria-label="현재 위치"><a href={href('설정집.html#atlas')}>설정집</a><span>/</span><a href={href(`설정집.html?axis=${node.axis}#atlas`)}>{axisName(node.axis)}</a><span>/</span><span>{node.name}</span></nav>
 <div class="dossier-lead"><p class="dossier-question">{node.question}</p><p class="dossier-intro">{node.intro}</p><span class="kind-badge">원문과 연결해 읽기</span></div>
 <nav class="dossier-jumps" aria-label="이 자료에서 읽기"><a href={'#'+(reading.topology?.id||'structure')}>{reading.topology?'핵심 구조':relationTitle}</a>{node.timeline.length>0&&<a href="#moments">{node.axis==='person'?'행적':'사건'}</a>}{comparison.panels.length>0&&<a href="#perspectives">관점 비교</a>}<a href={node.focusedSources?'#verified-sources':'#reading'}>{node.focusedSources?'원문':'원문·해설'}</a></nav>
 <span id="connections"></span><Fragment set:html={reading.topology?readingKit.topology(reading.topology):readingKit.network(reading.relations,{id:'structure',title:'관계 한눈에',focusId:reading.entityId})} />
 <Fragment set:html={reading.views.map(readingKit.topology).join('')} />
 {node.relationshipTitle&&<Fragment set:html={readingKit.network(reading.relations,{id:'affiliations',title:node.relationshipTitle,focusId:reading.entityId})} />}
 {supplementalRelations.length>0&&<Fragment set:html={readingKit.network(supplementalRelations,{id:'supplemental-relations',title:'관련 관계와 함께 읽을 기록',focusId:reading.entityId})} />}
 <Fragment set:html={reading.sections.map(readingKit.section).join('')} />

 {node.timeline.length>0&&<section id="moments"><h2>{node.axis==='person'?'삶의 전환점':'기록 속 사건 흐름'}</h2><Fragment set:html={readingKit.timeline(reading.events,{ordered:reading.timeOrdered,note:reading.timeNote})}/></section>}
 <Perspectives topic={node.topic} nodeId={node.id}/>
 {!node.focusedSources&&<section id="reading"><h2>더 깊이 읽기</h2>{!node.focusedSources&&<a class="dossier-essay-link" href={topicUrl(node.topic)} data-reading-link><span class="eyebrow">함께 읽을 이유를 풀어 쓴 해설</span><strong>{essay.title}</strong><span>{essay.deck}</span><span aria-hidden="true">→</span></a>}<p class="atlas-curation-note">정체·역사·인물 행적의 스포일러가 포함됩니다. 원문 서술, 기록자의 견해, 편집자의 연결은 각 근거에 표시했습니다.</p></section>}
 <SourceRegister entries={sources}/>
</StarlightPage>
